---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import HeroVisual from '../components/HeroVisual.jsx';
import GlobalNetwork from '../components/GlobalNetwork.jsx';

const units = [
  {
    code: '01',
    title: 'O7 Digital Consulting',
    type: 'OPERATING COMPANY',
    text: 'Digital engineering, technical SEO, web platforms, cloud architecture and transformation for international organizations.',
    tags: ['Consulting', 'Astro / React', 'SEO', 'Cloud']
  },
  {
    code: '02',
    title: 'AI & Automation',
    type: 'GROUP BUSINESS UNIT',
    text: 'Conversational AI, intelligent workflows and operational automation designed around real business processes.',
    tags: ['Olivia One', 'AI Agents', 'Automation', 'Data']
  },
  {
    code: '03',
    title: 'Platforms & Products',
    type: 'GROUP ECOSYSTEM',
    text: 'A growing portfolio of proprietary platforms for CRM, hospitality, operations and vertical business management.',
    tags: ['PulseCRM', 'Transport OS', 'Hospitality', 'SaaS']
  },
  {
    code: '04',
    title: 'Infrastructure & Managed IT',
    type: 'ENTERPRISE SERVICES',
    text: 'Infrastructure, cloud, security and managed services for organizations requiring continuity, control and international support.',
    tags: ['Managed IT', 'Cloud', 'Security', '24/7']
  }
];

const capabilities = [
  ['01','Digital Engineering','Modern platforms, headless architecture and high-performance applications.'],
  ['02','Artificial Intelligence','AI assistants, business copilots, language automation and intelligent orchestration.'],
  ['03','Enterprise Infrastructure','Hybrid cloud, managed environments, workplace and critical IT operations.'],
  ['04','Business Platforms','CRM, ERP-connected workflows and vertical operating systems.'],
  ['05','Growth & Search','Technical SEO, international acquisition architecture and measurable digital performance.'],
  ['06','Strategic Technology','Technology governance, transformation roadmaps and CTO-level advisory.']
];
---
<BaseLayout>
  <main id="top">
    <div class="page-grid" aria-hidden="true"></div>
    <Nav />

    <section class="hero section-shell">
      <div class="hero-copy">
        <div class="eyebrow" data-reveal><span></span> INTERNATIONAL TECHNOLOGY GROUP</div>
        <h1 data-reveal>We build.<br/><em>We operate.</em><br/>We scale.</h1>
        <p class="hero-lede" data-reveal>
          O7 Digital Group is an international technology holding connecting digital engineering, artificial intelligence, infrastructure and proprietary business platforms.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="btn-primary" href="#ecosystem">Explore the group <b>↘</b></a>
          <a class="btn-ghost" href="#footprint">International footprint <b>→</b></a>
        </div>
        <div class="hero-meta" data-reveal>
          <div><small>GROUP HQ</small><strong>London, United Kingdom</strong></div>
          <div><small>MARKETS</small><strong>Europe · North America · LATAM</strong></div>
        </div>
      </div>
      <HeroVisual client:load />
    </section>

    <section class="ticker" aria-label="Group focus">
      <div class="ticker-track">
        <span>TECHNOLOGY HOLDING</span><i>✦</i><span>DIGITAL ENGINEERING</span><i>✦</i><span>ARTIFICIAL INTELLIGENCE</span><i>✦</i><span>INFRASTRUCTURE</span><i>✦</i><span>BUSINESS PLATFORMS</span><i>✦</i>
        <span>TECHNOLOGY HOLDING</span><i>✦</i><span>DIGITAL ENGINEERING</span><i>✦</i><span>ARTIFICIAL INTELLIGENCE</span><i>✦</i><span>INFRASTRUCTURE</span><i>✦</i><span>BUSINESS PLATFORMS</span><i>✦</i>
      </div>
    </section>

    <section id="group" class="manifesto section-shell">
      <div class="section-index">01 — THE GROUP</div>
      <div class="manifesto-copy" data-reveal>
        <p class="kicker">ONE GROUP. MULTIPLE ENGINES.</p>
        <h2>Not an agency.<br/>A <em>technology ecosystem.</em></h2>
        <p>O7 Digital Group brings together service delivery, proprietary technology and operational expertise under one structure. The objective is simple: create durable digital assets, operate them efficiently and scale them internationally.</p>
      </div>
      <div class="manifesto-side" data-reveal>
        <div class="vertical-word">BUILD / OPERATE / SCALE</div>
        <div class="quote-mark">“</div>
        <p>From consulting to owned platforms, the group is designed to turn technological capability into recurring business value.</p>
      </div>
    </section>

    <section id="ecosystem" class="units section-shell">
      <div class="section-head" data-reveal>
        <div><span class="section-index">02 — GROUP ECOSYSTEM</span><h2>Four layers.<br/>One direction.</h2></div>
        <p>A clearer corporate architecture separates the Holding from the operating company while making the full O7 ecosystem visible.</p>
      </div>
      <div class="unit-grid">
        {units.map((unit) => (
          <article class="unit-card" data-reveal>
            <div class="unit-top"><span>{unit.code}</span><small>{unit.type}</small><b>↗</b></div>
            <div class="unit-body"><h3>{unit.title}</h3><p>{unit.text}</p></div>
            <div class="tag-row">{unit.tags.map(tag => <span>{tag}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="portfolio section-shell">
      <div class="portfolio-shell" data-reveal>
        <div class="portfolio-copy">
          <span class="section-index">03 — PROPRIETARY TECHNOLOGY</span>
          <h2>Technology we<br/><em>own and evolve.</em></h2>
          <p>Beyond client services, O7 develops reusable platforms and intelligent products that can be deployed across industries and markets.</p>
          <a href="#contact">Discuss partnerships <b>↗</b></a>
        </div>
        <div class="product-stack">
          <div class="product-card product-main">
            <div class="product-badge">AI CORE</div>
            <strong>OLIVIA <span>ONE</span></strong>
            <p>Conversational AI · automation · orchestration</p>
            <div class="pulse-line"></div>
          </div>
          <div class="product-card"><small>CRM PLATFORM</small><strong>O7 PulseCRM</strong><span>Customer operations</span></div>
          <div class="product-card"><small>VERTICAL OS</small><strong>O7 Transport OS</strong><span>Intelligent operations</span></div>
        </div>
      </div>
    </section>

    <section id="capabilities" class="capabilities section-shell">
      <div class="section-head compact" data-reveal>
        <div><span class="section-index">04 — CAPABILITIES</span><h2>Built across the stack.</h2></div>
        <p>Strategy, technology and operations brought together instead of fragmented across multiple vendors.</p>
      </div>
      <div class="cap-list">
        {capabilities.map(([n,title,text]) => (
          <article class="cap-row" data-reveal>
            <span>{n}</span><h3>{title}</h3><p>{text}</p><b>↗</b>
          </article>
        ))}
      </div>
    </section>

    <section id="footprint" class="footprint section-shell">
      <div class="footprint-copy" data-reveal>
        <span class="section-index">05 — INTERNATIONAL FOOTPRINT</span>
        <h2>Local execution.<br/><em>International reach.</em></h2>
        <p>The group is structured to serve organizations across time zones, languages and markets while keeping a single technological direction.</p>
        <div class="location-list">
          <div><small>01</small><strong>United Kingdom</strong><span>Holding & international governance</span></div>
          <div><small>02</small><strong>France / Europe</strong><span>Consulting & enterprise delivery</span></div>
          <div><small>03</small><strong>Mexico / Americas</strong><span>Operations, products & regional growth</span></div>
        </div>
      </div>
      <GlobalNetwork client:load />
    </section>

    <section class="partners section-shell" data-reveal>
      <span class="section-index">06 — TECHNOLOGY ECOSYSTEM</span>
      <p>Enterprise technologies integrated across group projects</p>
      <div class="partner-row"><strong>IBM</strong><strong>FUJITSU</strong><strong>Google Cloud</strong><strong>SECTIGO</strong></div>
    </section>

    <section id="contact" class="contact section-shell">
      <div class="contact-panel" data-reveal>
        <div class="contact-top"><span>07 / NEXT</span><span>LONDON · PARIS · MEXICO</span></div>
        <h2>Build what’s<br/>next <em>with us.</em></h2>
        <div class="contact-bottom">
          <p>Corporate opportunities, strategic partnerships, enterprise technology and international projects.</p>
          <a href="mailto:contact@o7digital.com">contact@o7digital.com <b>↗</b></a>
        </div>
      </div>
    </section>

    <footer class="footer section-shell">
      <div class="brand footer-brand"><span class="brand-mark"><b>O</b><i>7</i></span><span class="brand-copy"><strong>O7 DIGITAL GROUP</strong><small>HOLDING</small></span></div>
      <p>International technology group.<br/>Build. Operate. Scale.</p>
      <div class="footer-links"><a href="#group">Group</a><a href="#ecosystem">Ecosystem</a><a href="#contact">Contact</a></div>
      <div class="footer-legal">© 2026 O7 Digital Group. All rights reserved.</div>
    </footer>
  </main>
</BaseLayout>
