---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import HeroVisual from './HeroVisual.jsx';
import GlobalNetwork from './GlobalNetwork.jsx';
import EnterpriseSections from './EnterpriseSections.astro';
import { premium } from '../i18n/premium';
const { lang, t } = Astro.props;
const p = premium[lang];
const mapLabels = {
  aria: p.presence.title, active: lang === 'es' ? 'NODO ACTIVO' : 'ACTIVE HUB',
  usa: p.presence.usa.slice(0,2), canada: p.presence.canada.slice(0,2), mexico: p.presence.mexico.slice(0,2), europe: p.presence.europe.slice(0,2)
};
---
<BaseLayout lang={lang} title={t.meta.title} description={p.hero.text}>
  <main id="top">
    <div class="page-grid" aria-hidden="true"></div><Nav lang={lang} labels={p.nav} premium />
    <section class="hero premium-hero section-shell">
      <div class="hero-copy"><div class="eyebrow" data-reveal><span></span>{p.hero.eyebrow}</div><h1 data-reveal>{p.hero.title[0]}<br/><em>{p.hero.title[1]}</em><br/>{p.hero.title[2]}</h1><p class="hero-lede" data-reveal>{p.hero.text}</p><div class="hero-actions" data-reveal><a class="btn-primary" href="#technology">{p.hero.primary} <b>↘</b></a><a class="btn-ghost" href="#global-presence">{p.hero.secondary} <b>→</b></a></div><div class="hero-meta premium-meta" data-reveal><div><small>GLOBAL NETWORK</small><strong>{p.hero.regions}</strong></div><div><small>TECHNOLOGY FOCUS</small><strong>{p.hero.domains}</strong></div></div></div>
      <HeroVisual client:load labels={{ aria:p.hero.networkAria, core:p.hero.core, hubs:p.hero.hubs }} />
    </section>
    <section class="ticker" aria-label={t.tickerLabel}><div class="ticker-track">{[...p.hero.domains.split(' · '),...p.hero.domains.split(' · '),...p.hero.domains.split(' · ')].map((item)=><><span>{item}</span><i>✦</i></>)}</div></section>

    <section id="group" class="manifesto section-shell"><div class="section-index">01 — {p.overview.index}</div><div class="manifesto-copy" data-reveal><p class="kicker">{p.overview.kicker}</p><h2>{p.overview.title[0]}<br/><em>{p.overview.title[1]}</em></h2><p>{p.overview.text}</p></div><div class="manifesto-side" data-reveal><div class="vertical-word">AI / SOFTWARE / OPERATIONS</div><div class="quote-mark">“</div><p>{p.overview.quote}</p></div></section>

    <EnterpriseSections p={p} />

    <section id="global-presence" class="footprint global-presence section-shell">
      <div class="footprint-copy" data-reveal><span class="section-index">11 — {p.presence.index}</span><h2>{p.presence.title}</h2><div class="location-list premium-locations"><div><small>01</small><strong>{p.presence.usa[0]}</strong><span>{p.presence.usa[1]}</span></div><div class="canada-location"><small>02</small><strong>{p.presence.canada[0]}</strong><span>{p.presence.canada[1]}</span><address>{p.presence.canada[2]}<br/>{p.presence.canada[3]}<br/><a href={`tel:${p.presence.canada[4].replace(/[^+\d]/g,'')}`}>{p.presence.canada[4]}</a></address></div><div><small>03</small><strong>{p.presence.mexico[0]}</strong><span>{p.presence.mexico[1]}</span></div><div><small>04</small><strong>{p.presence.europe[0]}</strong><span>{p.presence.europe[1]}</span></div></div></div>
      <GlobalNetwork client:visible labels={mapLabels} />
    </section>

    <section class="partners enterprise-partners section-shell" data-reveal><span class="section-index">12 — {p.partners.index}</span><div><h2>{p.partners.title}</h2><p>{p.partners.text}</p></div><div class="partner-row"><strong>IBM</strong><strong>FUJITSU</strong><strong>Google Cloud</strong><strong>SECTIGO</strong></div></section>
    <section id="contact" class="contact section-shell"><div class="contact-panel" data-reveal><div class="contact-top"><span>13 / {t.contact.next}</span><span>USA · CANADA · MEXICO · EUROPE</span></div><h2>{t.contact.title[0]}<br/>{t.contact.title[1]} <em>{t.contact.title[2]}</em></h2><div class="contact-bottom"><p>{t.contact.text}</p><a href="mailto:contact@o7digitalgroup.com">contact@o7digitalgroup.com <b>↗</b></a></div></div></section>
    <footer class="footer section-shell"><div class="brand footer-brand"><span class="brand-mark"><b>O</b><i>7</i></span><span class="brand-copy"><strong>O7 DIGITAL GROUP</strong><small>HOLDING</small></span></div><p>{t.footer.tagline[0]}<br/>{t.footer.tagline[1]}</p><div class="footer-links"><a href="#group">{p.nav.group}</a><a href="#technology">{p.nav.technology}</a><a href="#global-presence">{p.nav.global}</a><a href="#contact">{p.nav.contact}</a></div><div class="footer-legal">© 2026 O7 Digital Group. {t.footer.rights}</div></footer>
  </main>
</BaseLayout>
